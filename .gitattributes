# Normalize line endings to LF in the repo, checked out per-platform.
* text=auto

# Explicit per-type handling
*.py   text diff=python
*.html text diff=html
*.css  text diff=css
*.md   text
*.yml  text
*.txt  text
*.ini  text
*.svg  text
*.png  binary
*.jpg  binary

# The database must never be line-ending mangled.
*.db    binary
*.sqlite binary

# Exported reports shouldn't be diffed or normalized.
*.csv -text

# Vendor JS files - preserve original line endings
static/vendor/**/*.js text eol=lf
static/vendor/**/*.css text eol=lf